<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/seerah_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/seerah_chapter_number"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/seerah_number_background"
        android:gravity="center"
        android:textColor="@color/seerah_white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/seerah_chapter_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/seerah_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seerah_chapter_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/seerah_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
