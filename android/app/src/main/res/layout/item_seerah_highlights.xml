<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/seerah_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/seerah_highlights_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/seerah_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/seerah_highlights_lesson_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="@string/seerah_label_lesson"
            android:textColor="@color/seerah_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seerah_highlights_lesson"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/seerah_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/seerah_highlights_fun_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="@string/seerah_label_fun"
            android:textColor="@color/seerah_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seerah_highlights_fun"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/seerah_text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/seerah_highlights_practice_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="@string/seerah_label_practice"
            android:textColor="@color/seerah_practice"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seerah_highlights_practice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/seerah_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
